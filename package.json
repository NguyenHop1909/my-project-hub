{
  "name": "my-project-hub",
  "version": "1.0.1",
  "description": "Trung tâm quản lý các website và dự án cá nhân",
  "main": "electron/main.cjs",
  "author": "NguyenHop1909",
  "license": "MIT",
  "scripts": {
    "dev": "npx serve . -l 4173",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "serve": "^14.2.5"
  },
  "build": {
    "appId": "com.nguyenhop.myprojecthub",
    "productName": "My Project Hub",
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false,
      "artifactName": "My-Project-Hub-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Project Hub"
    },
    "publish": [{
      "provider": "github",
      "owner": "NguyenHop1909",
      "repo": "my-project-hub",
      "releaseType": "release"
    }]
  }
}
